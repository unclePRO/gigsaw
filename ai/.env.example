GIGSAW_ENV=development
AI_PROVIDER=demo

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=gigsaw
# `native` is for the AI module's own collections. Use `backend_mongoose` with the Node.js User/Project schemas.
MONGODB_SCHEMA_MODE=native
# Leave false when connecting to a shared backend database: the AI service will not create indexes there.
MANAGE_MONGO_INDEXES=false
BACKEND_USERS_COLLECTION=users
BACKEND_PROJECTS_COLLECTION=projects
# A separate, AI-owned catalogue collection. Do not use the shared `users` or `projects` collection for this.
BACKEND_SERVICE_CATALOG_COLLECTION=ai_service_catalog

CHROMA_PERSIST_DIRECTORY=./storage/chroma
CHROMA_COLLECTION=freelancer_portfolios

API_HOST=0.0.0.0
API_PORT=8001
